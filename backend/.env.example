# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
DATABASE_URL="postgresql://username:password@host:5432/codionix_db?sslmode=require"

# Database Connection Pool
# CRITICAL: Configure these based on your database and deployment
# 
# Calculation guide:
# - If you have 100 max_connections on your DB and 5 app instances:
#   DB_POOL_MAX = (100 / 5) - 10% buffer = 18
# 
# - DB_POOL_MIN: Keep 2-5 warm connections to avoid cold starts
# - DB_IDLE_TIMEOUT_MS: Return idle connections after 30s to prevent exhaustion
# - DB_CONNECTION_TIMEOUT_MS: Fail fast after 10s instead of hanging
DB_POOL_MAX=5
DB_POOL_MIN=1
DB_IDLE_TIMEOUT_MS=20000
DB_CONNECTION_TIMEOUT_MS=15000

# Database Query Timeouts
# CRITICAL: Prevent runaway queries from exhausting connection pool
# 
# - DB_QUERY_TIMEOUT_MS: Kill individual queries that take too long
#   Set based on your slowest acceptable query (default: 10s)
# 
# - DB_TRANSACTION_TIMEOUT_MS: Kill transactions that hold locks too long
#   MUST be >= DB_QUERY_TIMEOUT_MS (default: 15s)
# 
# - DB_SLOW_QUERY_THRESHOLD_MS: Log queries slower than this for optimization
#   Set to your performance SLA (default: 1s)
DB_QUERY_TIMEOUT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=15000
DB_SLOW_QUERY_THRESHOLD_MS=1000

# JWT Secrets
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Codionix <noreply@codionix.com>"

LOG_LEVEL=info  # Use 'debug' for verbose correlation logs

# Cloudinary (File Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Metrics Configuration
METRICS_ENABLED=true
METRICS_COLLECT_INTERVAL_MS=30000

# Grafana Cloud Configuration
GRAFANA_CLOUD_URL=https://prometheus-prod-XX-XXXX.grafana.net/api/prom/push
GRAFANA_CLOUD_USERNAME=123456
GRAFANA_CLOUD_PASSWORD=glc_XXXXXXXXXXXXXXXXXXXXXXXXXXXX



# Google OAuth
# Get credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# GitHub OAuth
# Get credentials: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# ===================================
# OAUTH SETUP INSTRUCTIONS
# ===================================
#
# GOOGLE OAUTH:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs: Add your GOOGLE_CALLBACK_URL
# 5. Copy Client ID and Client Secret
#
# GITHUB OAUTH:
# 1. Go to https://github.com/settings/developers
# 2. New OAuth App
# 3. Homepage URL: http://localhost:5173 (or your frontend URL)
# 4. Authorization callback URL: Add your GITHUB_CALLBACK_URL
# 5. Copy Client ID and generate Client Secret
#
# PRODUCTION URLS:
# - Update FRONTEND_URL to your production domain
# - Update callback URLs to match production backend
# - Re-configure OAuth apps with production URLs

# Redis
REDIS_HOST=your-redis-host.com
REDIS_PORT=12345
REDIS_USERNAME=default
REDIS_PASSWORD=your-password
REDIS_TLS_ENABLED=true
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Redis Connection Settings
REDIS_MAX_RETRIES=10
REDIS_RETRY_DELAY_MS=100
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_PREFIX=codionix


# Cookie
COOKIE_SECRET=your_cookie_secret_min_32_chars_very_secure_random_string

# Cookie domain (set to your domain in production)
# Examples:
# - Production: .codionix.com (allows api.codionix.com to set cookies for app.codionix.com)
# - Development: localhost
COOKIE_DOMAIN=localhost

# Cookie security flags
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax 
COOKIE_MAX_AGE=604800000

# OAuth state expiry (10 minutes - industry standard)
OAUTH_STATE_EXPIRY_MS=600000

# PKCE configuration
PKCE_CODE_VERIFIER_LENGTH=128 


# REDIS CLOUD SETUP (Redis Labs):
# 1. Go to https://redis.com/try-free/
# 2. Sign up for free tier (30MB database)
# 3. Create new database
# 4. View connection string (example below):
#    redis-14508.crce179.ap-south-1-1.ec2.cloud.redislabs.com:14508
# 5. Parse into individual fields:
#    - REDIS_HOST: redis-14508.crce179.ap-south-1-1.ec2.cloud.redislabs.com
#    - REDIS_PORT: 14508
#    - REDIS_USERNAME: default
#    - REDIS_PASSWORD: <your-generated-password>
#    - REDIS_TLS_ENABLED: true (required for cloud)
#
# DO NOT use REDIS_URL - our config uses explicit options for safety

# PRODUCTION CHECKLIST:
# - Set COOKIE_SECURE=true
# - Set COOKIE_DOMAIN=.yourdomain.com
# - Set COOKIE_SAME_SITE=lax or strict
# - Update CORS_ORIGIN to production frontend URL
# - Update GOOGLE_CALLBACK_URL to production backend URL
# - Update GITHUB_CALLBACK_URL to production backend URL
